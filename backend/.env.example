# Backend environment configuration
# Copy this to .env and fill in real values
# NEVER commit .env

# Application
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cctv_hackathon
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_SSL=false

# JWT (Phase 2 - placeholders required now for config validation)
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING_HERE
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_MIN_32_CHARS_RANDOM_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Engine
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=internal_service_key_change_me

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
